**/node_modules
**/.next
**/dist
**/.turbo
**/.yarn/cache
**/.yarn/install-state.gz
**/coverage
# Don't bake packages/db/.env — it forces Prisma to use its Supabase URL
# even when docker-compose injects a different DATABASE_URL at runtime.
# apps/admin/.env is intentionally kept for build-time Firebase config.
packages/db/.env
packages/db/.env.local
apps/admin/src/**/*.js
apps/admin/src/**/*.js.map
apps/admin/src/**/*.d.ts
apps/admin/src/**/*.d.ts.map
.git
.github
docs/superpowers
.superpowers
.vscode
.idea
*.log
