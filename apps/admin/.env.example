# ==============================================================
# VX Admin — Environment Configuration
# Copy to `.env.local` and fill in values. `.env.local` is gitignored.
# ==============================================================

# ----- Required -----

# Firebase Client SDK (browser auth + Firestore client)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-side API routes)
# Path to service account JSON. If empty, auto-discovers:
#   ./service-account.development.json
#   ../../service-account.development.json
FIREBASE_SERVICE_ACCOUNT_PATH=

# ----- Admin operator auth (custom DB-backed username/password login) -----
# JWT signing secret for operator sessions. REQUIRED. Use a long random string.
AUTH_JWT_SECRET=
# Bootstrap admin created on deploy seed (prisma db seed). Idempotent — the
# password is only used when the account does not yet exist.
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# Cloudflare R2 — public base URL used in image src attrs
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://image.lagroups.org

# Cloudflare R2 — server credentials for upload
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=coloring-app
R2_PUBLIC_BASE_URL=https://image.lagroups.org

# Redis — BullMQ queue (shared with apps/worker)
REDIS_URL=redis://localhost:6379

# Postgres — primary data store (replaces Firestore)
# Docker compose default; for prod use Neon/Supabase connection string.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.lhbxjsvkgoqdhfzhelqk.supabase.co:5432/postgres

# ----- LLM provider (Azure is default; pick ONE provider per channel) -----

# Azure OpenAI (default for both text+vision and image)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_LLM_DEPLOYMENT_NAME=gpt-4o
AZURE_LLM_TEXT_DEPLOYMENT_NAME=gpt-4o
AZURE_IMAGE_DEPLOYMENT_NAME=gpt-image-2
OPENAI_API_VERSION=2025-04-01-preview

# Image provider selector — "azure" (default) | "gemini" | "vertex" | "diaflow" | "kingcong"
IMAGE_PROVIDER=vertex

# LLM provider selector — empty = azure | "diaflow"
LLM_PROVIDER=

# ----- Optional providers (only if selected above) -----

# Google Gemini (IMAGE_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation

# Vertex AI (IMAGE_PROVIDER=vertex)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
VERTEX_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation
# Local-dev only — path to GCP service account; on GCP runtime auto-detected
GOOGLE_APPLICATION_CREDENTIALS=

# Diaflow (LLM_PROVIDER=diaflow and/or IMAGE_PROVIDER=diaflow)
DIAFLOW_API_URL=https://api.diaflow.io
# Token pool — comma-separated. On "out of credit" the active key is put in a
# shared cooldown and the request is retried with the next key automatically.
# DIAFLOW_TOKEN (single) still works and is used as a fallback if TOKENS unset.
DIAFLOW_TOKENS=
DIAFLOW_TOKEN=
DIAFLOW_POLL_INTERVAL=3
DIAFLOW_POLL_TIMEOUT=300
# Key rotation tuning (optional)
DIAFLOW_KEY_COOLDOWN_SECONDS=7200
# Extra body substrings (comma-separated) that mark a response as out-of-credit,
# added on top of the built-in defaults (credit/quota/insufficient/balance/...).
DIAFLOW_CREDIT_ERROR_KEYWORDS=
# One-shot clone flow (separate account) — its own comma-separated pool.
# Falls back to DIAFLOW_ONE_SHOT_TOKEN, then to DIAFLOW_TOKENS/DIAFLOW_TOKEN.
DIAFLOW_ONE_SHOT_TOKENS=

# ----- Optional observability -----

# Langfuse — LLM tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# KingCong Studio (IMAGE_PROVIDER=kingcong) — internal ajaxs/image.php, session-cookie auth
KINGCONG_BASE_URL=https://kingcongstudio.com
KINGCONG_IMAGE_MODEL=gemini-3.1-flash-lite-image
# Option A (serverless/Next): paste the full browser cookie string here
KINGCONG_COOKIE=
# Option B (worker): store cookie in a file + auto re-login via Playwright profile
KINGCONG_SESSION_FILE=.kingcong-session.json
KINGCONG_USER_DATA_DIR=.kingcong-profile
KINGCONG_RELOGIN_ENABLED=true
KINGCONG_POLL_INTERVAL=3
KINGCONG_POLL_TIMEOUT=180
