# ==============================================================
# VX Worker — Environment Configuration
# Copy to `.env` and fill in values. `.env` is gitignored.
# The worker validates these at boot with zod and exits on any missing required var.
# ==============================================================

# ----- Required: Queue (shared with admin) -----
REDIS_URL=redis://localhost:6379

# ----- Required: Postgres (shared with admin) -----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coloring

# ----- Required: Telegram notifications (2 channels) -----
# Bot token from @BotFather. Add the bot as Admin in BOTH channels below.
TELEGRAM_BOT_TOKEN=
# Numeric chat ids — usually start with -100. Use @userinfobot to discover them.
TELEGRAM_SUCCESS_CHAT_ID=
TELEGRAM_FAIL_CHAT_ID=

# ----- Optional: deep-link prefix in Telegram messages -----
# Example success message will include  <ADMIN_BASE_URL>/books/<bookId>
ADMIN_BASE_URL=http://localhost:3000

# ----- Optional: stale-job reconciler at boot -----
# On boot the worker can re-enqueue jobs stuck in queued/running and reprocess
# them. This is heavy, and with `node --watch` (dev) every restart re-runs it —
# the main cause of local machines hanging. Defaults ON only when
# NODE_ENV=production. Set to "true"/"1" to force on in dev, "false"/"0" to force off.
# RECONCILE_ON_BOOT=false

# ----- Required: Cloudflare R2 (mirror admin) -----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=coloring-app
R2_PUBLIC_BASE_URL=https://image.lagroups.org

# ----- Required: LLM + Image providers (mirror admin) -----
# The worker reuses apps/admin/src/lib/ai/* helpers, so the same provider vars apply.

# Azure OpenAI (default)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_LLM_DEPLOYMENT_NAME=gpt-4o
AZURE_LLM_TEXT_DEPLOYMENT_NAME=gpt-4o
AZURE_IMAGE_DEPLOYMENT_NAME=gpt-image-2
OPENAI_API_VERSION=2025-04-01-preview

# Selectors:
#   IMAGE_PROVIDER = azure (default) | gemini | vertex | diaflow | kingcong | litellm
#   LLM_PROVIDER   = empty=azure | diaflow | litellm
IMAGE_PROVIDER=vertex
LLM_PROVIDER=

# ----- Optional providers (only if selected above) -----

# LiteLLM proxy (LLM_PROVIDER=litellm and/or IMAGE_PROVIDER=litellm)
# OpenAI-compatible. Text+vision and image both go through /v1/chat/completions.
# NOTE: the one-shot clone flow (cloneOneShot) is Diaflow-only. To run CLONE
# jobs on LiteLLM you MUST use the multi-step pipeline: set CLONE_USE_MULTI_STEP=true
# (or create the job with useMultiStep:true). Generation/cover jobs work as-is.
LITELLM_BASE_URL=https://litellm-dev.diaflow.io
LITELLM_API_KEY=
LITELLM_TEXT_MODEL=saigon
LITELLM_IMAGE_MODEL=gemini-3.1-flash-image
# TLS for the LiteLLM host ONLY (other HTTPS stays verified). If the domain
# serves a self-signed / private cert you'll get "self-signed certificate" errors.
# DEV: skip verification —
# LITELLM_TLS_INSECURE=true
# PROD-safe: trust a specific CA on top of system roots —
# Repo-relative (portable) or absolute path; relative resolves against repo root:
# LITELLM_CA_CERT=certs/vxsolutions-litellm-cert.pem
# CLONE_USE_MULTI_STEP=true

# Auto-classify: skip the manual classification-review gate so clone jobs run
# end-to-end (…→ create-book → generate-cover → generate-book-meta → finalize-cover)
# and ship with full AI meta automatically. Leave unset to require operator review.
# CLONE_AUTO_CLASSIFY=true

# Google Gemini (IMAGE_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation

# Vertex AI (IMAGE_PROVIDER=vertex)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
VERTEX_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation
GOOGLE_APPLICATION_CREDENTIALS=

# Diaflow (LLM_PROVIDER=diaflow and/or IMAGE_PROVIDER=diaflow)
DIAFLOW_API_URL=https://api.diaflow.io
# Token pool — comma-separated. On "out of credit" the active key is put in a
# shared cooldown and the request is retried with the next key automatically.
# DIAFLOW_TOKEN (single) still works and is used as a fallback if TOKENS unset.
DIAFLOW_TOKENS=
DIAFLOW_TOKEN=
DIAFLOW_POLL_INTERVAL=3
DIAFLOW_POLL_TIMEOUT=300
# Key rotation tuning (optional)
DIAFLOW_KEY_COOLDOWN_SECONDS=7200
DIAFLOW_CREDIT_ERROR_KEYWORDS=
# One-shot clone flow (separate account) — its own comma-separated pool.
# Falls back to DIAFLOW_ONE_SHOT_TOKEN, then to DIAFLOW_TOKENS/DIAFLOW_TOKEN.
DIAFLOW_ONE_SHOT_TOKENS=

# ----- Optional observability -----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ----- B&W coloring page frame (KDP-safe) -----
# Draw a hand-drawn square frame + safe margin around interior B&W pages.
# Default ON. Set to 0 / false / off to generate full-bleed (no frame).
# COLORING_PAGE_FRAME=1
