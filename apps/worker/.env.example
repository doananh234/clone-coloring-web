# ==============================================================
# VX Worker — Environment Configuration
# ==============================================================
# Copy this to .env (or set in your runtime) and fill in values.
# The worker validates these at boot with zod and exits on missing required vars.
# ==============================================================

# --- Redis (REQUIRED) ---
# Same instance as apps/admin uses.
REDIS_URL=redis://localhost:6379

# --- Telegram (REQUIRED) ---
# Bot token from @BotFather, plus two separate chat ids for success/failure.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SUCCESS_CHAT_ID=
TELEGRAM_FAIL_CHAT_ID=

# --- Admin base URL (OPTIONAL) ---
# Used in Telegram message deep-links: <ADMIN_BASE_URL>/books/<bookId>
# and <ADMIN_BASE_URL>/clone?job=<jobId> for failure retry.
ADMIN_BASE_URL=https://admin.example.com

# --- Firebase Admin SDK (REQUIRED) ---
# Inline service-account JSON (single line — escape newlines in private_key).
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- R2 (REQUIRED — shared with admin) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=coloring-app
R2_PUBLIC_BASE_URL=https://image.lagroups.org

# --- LLM / Image provider creds (REQUIRED — same set as admin) ---
# Mirror the admin .env. The worker reuses apps/admin/src/lib/ai/* helpers.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_LLM_DEPLOYMENT_NAME=gpt-4o
AZURE_IMAGE_DEPLOYMENT_NAME=gpt-image-2
OPENAI_API_VERSION=2025-04-01-preview
IMAGE_PROVIDER=vertex
LLM_PROVIDER=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
