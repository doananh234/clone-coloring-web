# ==============================================================
# VX Motion — "self-drawing" animation service
# Turns a coloring-page line-art image into a draw-on MP4.
# Copy to `.env` and fill in values.
# ==============================================================

# Port the HTTP service listens on.
MOTION_PORT=7801

# Optional: explicit ffmpeg binary. Defaults to the bundled ffmpeg-static, then
# the system `ffmpeg` on PATH.
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# ----- Cloudflare R2 (mirror admin/worker) — required only to upload MP4s -----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=coloring-app
R2_PUBLIC_BASE_URL=https://image.lagroups.org
