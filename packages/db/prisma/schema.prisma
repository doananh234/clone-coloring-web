generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Singleton app config (Firestore: collection "app")
model App {
  id        String   @id @default("default")
  data      Json     @default(dbgenerated("'{}'"))
  updatedAt DateTime @updatedAt
}

model Book {
  id                 String   @id @default(cuid())
  title              String
  subtitle           String?
  description        String?
  price              String?
  originalPrice      String?
  discount           String?
  category           String?
  categoryId         String?
  badge              String?
  backgroundColor    String?
  tryoutPage         String?
  coverUrl           String   @default("")
  pdfUrl             String?
  squareThumbnailUrl String?
  thumbnailUrl       String?
  summaryPages       Json     @default(dbgenerated("'[]'"))
  coloringPages      Json     @default(dbgenerated("'[]'"))
  isPublic           Boolean  @default(false)
  // Operator (Operator.id) this book is assigned to. Null = unassigned (visible
  // to all operators). Once assigned, only the assignee + admins see it.
  assignedToId       String?
  data               Json     @default(dbgenerated("'{}'"))
  priceAmount        Int?
  // Denormalized, read-only from the app's perspective: a Postgres trigger
  // (book_denorm_perf, see prisma/books-denorm-2026-08.sql) keeps these in sync
  // with coloringPages / data on every write, so the books list can filter
  // "interior > N" and search niche via btree instead of a JSONB path scan.
  // No app code writes these columns — Prisma only reads/filters them.
  interiorPages      Int?
  niche              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  // NOTE: the Postgres GIN index on coloringPages (jsonb containment) is omitted
  // on SQLite — jsonb operators/GIN don't exist here. Containment lookups fall
  // back to a table scan; fine for local dev volumes.

  @@index([categoryId])
  @@index([priceAmount])
  // Default books view filters isPublic + interiorPages > 40; the count() over
  // that predicate is the residual cost after the createdAt indexes, so this
  // composite lets it count over a narrow int column instead of detoasting data.
  @@index([isPublic, interiorPages])
  // List view orders by createdAt desc; the default admin view filters isPublic
  // and non-admins filter by assignedToId — composite indexes let Postgres walk
  // in sort order + early-stop at the page LIMIT instead of seq-scan + full sort.
  @@index([createdAt])
  @@index([isPublic, createdAt])
  @@index([assignedToId, createdAt])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  displayName String?
  description String?
  iconUrl     String?
  iconPrompt  String?
  isPublic    Boolean  @default(false)
  index       Int?
  books       Json     @default(dbgenerated("'[]'"))
  data        Json     @default(dbgenerated("'{}'"))
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Brand {
  id          String   @id @default(cuid())
  name        String
  displayName String?
  description String?
  logoUrl     String?
  isPublic    Boolean  @default(false)
  index       Int?
  data        Json     @default(dbgenerated("'{}'"))
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Character {
  id                String   @id @default(cuid())
  name              String
  type              String?
  role              String?
  visualDna         Json     @default(dbgenerated("'{}'"))
  characterPrompt   String?
  tags              Json     @default(dbgenerated("'[]'"))
  referenceImageUrl String?
  sourceBookId      String?
  data              Json     @default(dbgenerated("'{}'"))
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([sourceBookId])
}

model Location {
  id                String   @id @default(cuid())
  name              String
  description       String?
  visualDescription String?
  locationPrompt    String?
  atmosphere        Json     @default(dbgenerated("'{}'"))
  props             Json     @default(dbgenerated("'[]'"))
  tags              Json     @default(dbgenerated("'[]'"))
  referenceImageUrl String?
  sourceBookId      String?
  data              Json     @default(dbgenerated("'{}'"))
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([sourceBookId])
  // Entity lists sort by name (list-query.ts default orderBy).
  @@index([name])
}

model ArtStyle {
  id                  String   @id @default(cuid())
  name                String
  description         String?
  thumbnailUrl        String?
  referenceImages     Json     @default(dbgenerated("'[]'"))
  lineWork            Json     @default(dbgenerated("'{}'"))
  composition         Json     @default(dbgenerated("'{}'"))
  formAndShape        Json     @default(dbgenerated("'{}'"))
  moodAndAtmosphere   Json     @default(dbgenerated("'{}'"))
  patternAndTexture   Json     @default(dbgenerated("'{}'"))
  technical           Json     @default(dbgenerated("'{}'"))
  generationDirective String?
  tags                Json     @default(dbgenerated("'[]'"))
  sourceBookId        String?
  data                Json     @default(dbgenerated("'{}'"))
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Entity lists sort by name (list-query.ts default orderBy).
  @@index([name])
}

model ColoringStyle {
  id                    String   @id @default(cuid())
  name                  String
  description           String?
  thumbnailUrl          String?
  referenceImages       Json     @default(dbgenerated("'[]'"))
  medium                Json     @default(dbgenerated("'{}'"))
  colorPalette          Json     @default(dbgenerated("'{}'"))
  shadingAndLighting    Json     @default(dbgenerated("'{}'"))
  fillBehavior          Json     @default(dbgenerated("'{}'"))
  overallFeel           Json     @default(dbgenerated("'{}'"))
  colorizationDirective String?
  tags                  Json     @default(dbgenerated("'[]'"))
  // Color variants: one style groups many palettes. Each item =
  // { id, colorPalette, thumbnailUrl, colorizationDirective, sourceBookId, createdAt }.
  // The style's own top-level colorPalette/thumbnailUrl mirror variant #1.
  variants              Json     @default(dbgenerated("'[]'"))
  sourceBookId          String?
  data                  Json     @default(dbgenerated("'{}'"))
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// CSV-imported source book metadata
model SourceBook {
  id               String   @id
  fileName         String?
  fileSize         String?
  topicName        String?
  thumbnailUrl     String?
  thumbnailPreview String?
  bookUrl          String?
  selected         Boolean  @default(false)
  removed          Boolean  @default(false)
  niche            String?
  priority         String?
  importedFromCsv  String?
  data             Json     @default(dbgenerated("'{}'"))
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Purchase {
  id          String   @id @default(cuid())
  userId      String?
  bookId      String?
  type        String?
  status      String?  @default("pending")
  amount      Int?
  currency    String?  @default("USD")
  provider    String?
  providerRef String?
  data        Json     @default(dbgenerated("'{}'"))
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([bookId])
  // Purchases list orders by createdAt desc.
  @@index([createdAt])
}

model Wallet {
  id        String   @id
  balance   Int      @default(0)
  currency  String   @default("USD")
  data      Json     @default(dbgenerated("'{}'"))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Wallets list orders by updatedAt desc.
  @@index([updatedAt])
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  name         String?
  avatarUrl    String?
  passwordHash String?
  role         String   @default("user")
  data         Json     @default(dbgenerated("'{}'"))
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Users list orders by createdAt desc.
  @@index([createdAt])
}

model CreditLedger {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  type        String
  description String?
  data        Json     @default(dbgenerated("'{}'"))
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Long-running clone pipeline job
model CloneJob {
  id             String   @id @default(cuid())
  name           String
  status         String   @default("pending")
  sourceBookId   String?
  sourceFileName String?
  sourcePdfUrl   String?
  totalPages     Int      @default(0)
  analyzedPages  Int      @default(0)
  pages          Json     @default(dbgenerated("'[]'"))
  bookData       Json?
  entityMap      Json?
  bookId         String?
  resultBookId   String?
  error          String?
  data           Json     @default(dbgenerated("'{}'"))
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt])
  @@index([sourceBookId])
  // List filters by status and orders by createdAt (queue tabs) or updatedAt
  // (terminal tabs: reproduced/error). These composites cover both sorts; the
  // status-only filter still uses the leftmost prefix of [status, createdAt].
  @@index([status, createdAt])
  @@index([status, updatedAt])
}

// Cached counts per CloneJob.status — avoids a full `groupBy` scan on every
// summary read. Bumped at hot mutation sites (create / delete / status change)
// and self-heals via a full recompute when the cache is empty or stale.
model CloneJobStatusCount {
  status    String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Background image-generation job. Long-running gen (Diaflow ~2min) is enqueued
// here and processed by the worker so the operator can keep working while it
// runs. Currently: source-cover generation. `type` is a string so colorize (and
// other kinds) can be added later without a schema change.
model GenerationJob {
  id        String   @id @default(cuid())
  type      String // "source-cover"
  status    String   @default("pending") // pending | running | done | error
  bookId    String
  bookTitle String?
  // Kind-specific input, e.g. { interiorPageId, titleSafe, prompt?, sourceImageUrl? }.
  payload   Json     @default(dbgenerated("'{}'"))
  resultUrl String? // generated image url (for quick preview in the drawer)
  resultId  String? // id of the created artifact (e.g. sourceCover id)
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([bookId])
  @@index([createdAt])
}

model Font {
  id        String   @id @default(cuid())
  name      String
  fileUrl   String
  format    String
  weight    Int?
  isPublic  Boolean  @default(true)
  data      Json     @default(dbgenerated("'{}'"))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

// Reusable per-element cover text STYLE+LAYOUT extracted from a source cover
// (title/subtitle/brand/badge → font/weight/color/size/align/position). The
// `elements` payload shape is defined by CoverElementExtract in
// packages/coloring/src/lib/cover-doc.ts and stored here opaquely as JSON.
model CoverTextOverlay {
  id                String   @id @default(cuid())
  name              String
  elements          Json     @default(dbgenerated("'{}'"))
  referenceImageUrl String?
  isPublic          Boolean  @default(true)
  data              Json     @default(dbgenerated("'{}'"))
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([createdAt])
}

model UserColoring {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  pageId    String?
  pageIndex Int?
  status    String   @default("in_progress")
  imageUrl  String?
  progress  Json     @default(dbgenerated("'{}'"))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([bookId])
}

// Admin/operator accounts for the custom DB-backed admin auth. Separate from
// the customer-facing `User` model — do not conflate the two.
model Operator {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  name         String
  role         String    @default("operator") // "admin" | "operator"
  disabled     Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("operators")
}
